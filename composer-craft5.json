{
    "name": "markhuot/craft-ai",
    "description": "A multi-agent AI interface for Craft CMS",
    "type": "craft-plugin",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "craftcms/cms": "^5.0 || ^6.0",
        "mcp/sdk": "^0.5.0",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1"
    },
    "require-dev": {
        "markhuot/craft-pest-core": "*",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "markhuot\\craftai\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/craft5/"
        }
    },
    "extra": {
        "handle": "craft-ai",
        "name": "Craft AI",
        "developer": "Mark Huot",
        "developerEmail": "mark@happycog.com",
        "class": "markhuot\\craftai\\Plugin"
    },
    "scripts": {
        "test": "@php vendor/bin/pest -c phpunit.craft5.xml --test-directory=tests/craft5"
    },
    "config": {
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "yiisoft/yii2-composer": true,
            "pestphp/pest-plugin": true
        }
    }
}
