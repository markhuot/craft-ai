{
    "name": "markhuot/craft-ai",
    "description": "A multi-agent AI interface for Craft CMS",
    "type": "craft-plugin",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "craftcms/cms": "^5.0 || ^6.0",
        "mcp/sdk": "^0.5.0",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1"
    },
    "require-dev": {
        "craftcms/yii2-adapter": "^6.0",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/phpstan": "^2.1"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "markhuot\\craftai\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/craft6/",
            "CraftCms\\Cms\\Database\\": "vendor/craftcms/cms/database/"
        }
    },
    "extra": {
        "handle": "craft-ai",
        "name": "Craft AI",
        "developer": "Mark Huot",
        "developerEmail": "mark@happycog.com",
        "class": "markhuot\\craftai\\Plugin"
    },
    "scripts": {
        "test": "@php bin/craft6-tests.php"
    },
    "config": {
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "yiisoft/yii2-composer": true,
            "craftcms/yii2-adapter": true,
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    }
}
