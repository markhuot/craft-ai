{#
  One slash-command row on the plugin settings page. Read-only display +
  edit/delete actions — the actual edit form lives on a dedicated screen
  (`ai/commands/<uid>`) so the prompt textarea isn't cramped into a cell.

  The row also re-emits the current command state as hidden inputs scoped
  under `commands[<i>]`. Reason: the parent settings form saves via
  Craft's PluginsController, which writes `plugins.craft-ai.settings` as
  a full project-config replacement. Without these hidden inputs, saving
  the automations table above would silently wipe the persisted commands.

  Parameters:
    index: int|string — row index used for the hidden-input array keys.
    cmd:   Command    — the model being displayed (always set; the index
                        page only renders rows for persisted commands).
#}

{% set base = 'commands[' ~ index ~ ']' %}

<tr>
    <td class="craftai-commands__name">
        <a href="{{ url('ai/commands/' ~ cmd.uid) }}">/{{ cmd.name }}</a>
    </td>
    <td>
        <div class="craftai-commands__prompt">{{ cmd.prompt }}</div>
    </td>
    <td class="thin">
        {% if cmd.enabled %}
            <span class="status enabled" aria-label="{{ 'Enabled'|t('craft-ai') }}"></span>
        {% else %}
            <span class="status" aria-label="{{ 'Disabled'|t('craft-ai') }}"></span>
        {% endif %}
    </td>
    <td class="thin">
        <span class="craftai-commands__row-actions">
            <a class="btn small" href="{{ url('ai/commands/' ~ cmd.uid) }}">{{ "Edit"|t('craft-ai') }}</a>
        </span>
        {# Round-trip hidden inputs so the parent settings save doesn't drop
           commands — see template header for the full reasoning. They sit
           inside this cell because the table parser would otherwise re-
           parent loose <input> elements out of <tbody>. #}
        <input type="hidden" name="{{ base }}[uid]" value="{{ cmd.uid }}">
        <input type="hidden" name="{{ base }}[name]" value="{{ cmd.name }}">
        <input type="hidden" name="{{ base }}[prompt]" value="{{ cmd.prompt }}">
        <input type="hidden" name="{{ base }}[enabled]" value="{{ cmd.enabled ? '1' : '' }}">
    </td>
</tr>
