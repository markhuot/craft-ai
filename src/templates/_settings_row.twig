{#
  One automation row on the plugin settings page. Read-only display +
  edit/delete actions — the actual edit form lives on a dedicated screen
  (`ai/automations/<uid>`) so the prompt textarea has room to breathe.

  The row also re-emits the current automation state as hidden inputs
  scoped under `automations[<i>]`. Reason: the parent settings form
  saves via Craft's PluginsController, which writes
  `plugins.craft-ai.settings` as a full project-config replacement.
  Without these hidden inputs, saving the slash-commands section below
  would silently wipe the persisted automations.

  Parameters:
    index:        int|string — row index used for the hidden-input array keys.
    auto:         Automation — the model being displayed.
    eventChoices: array<string, string> — event => human label.
    scopeByEvent: array<string, ?string> — event => 'section'|'volume'|null.
#}

{% set base = 'automations[' ~ index ~ ']' %}
{% set scopeKind = scopeByEvent[auto.event] ?? null %}

<tr>
    <td>
        {% if auto.name %}
            <a href="{{ url('ai/automations/' ~ auto.uid) }}">{{ auto.name }}</a>
        {% else %}
            <a href="{{ url('ai/automations/' ~ auto.uid) }}" class="light">{{ "(no name)"|t('craft-ai') }}</a>
        {% endif %}
    </td>
    <td>{{ eventChoices[auto.event] ?? auto.event }}</td>
    <td>
        {% if scopeKind == 'section' %}
            {{ auto.sectionHandle ?: '— Any section —'|t('craft-ai') }}
        {% elseif scopeKind == 'volume' %}
            {{ auto.volumeHandle ?: '— Any volume —'|t('craft-ai') }}
        {% else %}
            <span class="light">—</span>
        {% endif %}
    </td>
    <td>
        <div class="craftai-automations__prompt">{{ auto.prompt }}</div>
    </td>
    <td class="thin">
        {% if auto.enabled %}
            <span class="status enabled" aria-label="{{ 'Enabled'|t('craft-ai') }}"></span>
        {% else %}
            <span class="status" aria-label="{{ 'Disabled'|t('craft-ai') }}"></span>
        {% endif %}
    </td>
    <td class="thin">
        <span class="craftai-automations__row-actions">
            <a class="btn small" href="{{ url('ai/automations/' ~ auto.uid) }}">{{ "Edit"|t('craft-ai') }}</a>
        </span>
        {# Round-trip hidden inputs so the parent settings save doesn't
           drop automations — see template header for the full reasoning.
           They sit inside this cell because the table parser would
           otherwise re-parent loose <input> elements out of <tbody>. #}
        <input type="hidden" name="{{ base }}[uid]" value="{{ auto.uid }}">
        <input type="hidden" name="{{ base }}[name]" value="{{ auto.name }}">
        <input type="hidden" name="{{ base }}[event]" value="{{ auto.event }}">
        <input type="hidden" name="{{ base }}[sectionHandle]" value="{{ auto.sectionHandle }}">
        <input type="hidden" name="{{ base }}[volumeHandle]" value="{{ auto.volumeHandle }}">
        <input type="hidden" name="{{ base }}[prompt]" value="{{ auto.prompt }}">
        <input type="hidden" name="{{ base }}[enabled]" value="{{ auto.enabled ? '1' : '' }}">
    </td>
</tr>
