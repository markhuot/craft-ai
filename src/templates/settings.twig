{% import "_includes/forms" as forms %}

{#
  CP settings form for craft-ai. Both automations and slash commands
  render as read-only lists here; clicking a row opens a dedicated edit
  screen where the prompt textarea has room to breathe.

  Why each list still emits hidden inputs: Craft writes plugin settings
  via a project-config `set()` at `plugins.craft-ai.settings`, which is a
  full-subtree replace. The parent settings form's Save button posts the
  whole `settings[...]` payload to Craft's PluginsController. If one
  half (automations or commands) is missing from the post, that half
  gets wiped. So we round-trip the current state through hidden inputs
  even though the visible UI is read-only.

  See AutomationsController / CommandsController for the actual edit
  flow — each saves a single row at a time and re-emits the *other*
  half of settings for the same reason.
#}

<h2>{{ "Automations"|t('craft-ai') }}</h2>
<p class="instructions">{{
    "Each automation listens for a Craft event and starts a new agent session with the prompt below whenever the event fires. The triggering element is appended to the session as context, so the agent can fetch and act on it directly."|t('craft-ai')
}}</p>

<div class="craftai-automations">
    {% set automations = settings.getAutomations() %}

    {% if automations %}
        <table class="data fullwidth craftai-automations__table">
            <thead>
                <tr>
                    <th>{{ "Name"|t('craft-ai') }}</th>
                    <th>{{ "Event"|t('craft-ai') }}</th>
                    <th>{{ "Scope"|t('craft-ai') }}</th>
                    <th>{{ "Prompt"|t('craft-ai') }}</th>
                    <th class="thin">{{ "Enabled"|t('craft-ai') }}</th>
                    <th class="thin"></th>
                </tr>
            </thead>
            <tbody>
                {% for i, auto in automations %}
                    {% include 'craft-ai/_settings_row.twig' with {
                        index: i,
                        auto: auto,
                        eventChoices: eventChoices,
                        scopeByEvent: scopeByEvent,
                    } only %}
                {% endfor %}
            </tbody>
        </table>
    {% else %}
        <p class="light">{{ "No automations yet."|t('craft-ai') }}</p>
    {% endif %}

    <div class="craftai-automations__actions">
        <a class="btn add icon" href="{{ url('ai/automations/new') }}">
            {{ "Add an automation"|t('craft-ai') }}
        </a>
    </div>
</div>

<style>
    .craftai-automations__table td,
    .craftai-automations__table th {
        vertical-align: top;
    }
    .craftai-automations__actions {
        margin-top: 8px;
    }
    .craftai-automations__prompt {
        color: var(--medium-text-color);
        max-width: 36rem;
        /* Same two-line clamp as the slash-commands list — the dedicated
           edit screen is where the full prompt actually reads. */
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .craftai-automations__row-actions {
        display: inline-flex;
        gap: 6px;
        white-space: nowrap;
    }
    .craftai-commands__table td,
    .craftai-commands__table th {
        vertical-align: top;
    }
    .craftai-commands__actions {
        margin-top: 8px;
    }
    .craftai-commands__name a {
        font-family: var(--mono-font, ui-monospace, monospace);
    }
    .craftai-commands__prompt {
        color: var(--medium-text-color);
        max-width: 36rem;
        /* Clamp to two lines so a long prompt doesn't blow the row up;
           the dedicated edit screen is where you actually read it. */
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .craftai-commands__row-actions {
        display: inline-flex;
        gap: 6px;
        white-space: nowrap;
    }
</style>

<hr>

<h2>{{ "Slash commands"|t('craft-ai') }}</h2>
<p class="instructions">{{
    "Slash commands let editors invoke a saved prompt from the chat input by typing /name. The plugin ships with two seeded commands. Each command opens in its own editor so the prompt can be as long as it needs to be."|t('craft-ai')
}}</p>

{#
  Read-only list. Each row links to a dedicated edit screen
  (`ai/commands/<uid>`) where the prompt gets a real textarea instead of
  a cramped table cell. The parent settings form still has to POST the
  current commands — Craft writes plugin settings via a project-config
  `set()` at `plugins.craft-ai.settings`, which is a full replace; if we
  omit `commands` here, saving the automations table below would wipe the
  saved commands. So we mirror each row's persisted state as hidden inputs.
#}

<div class="craftai-commands">
    {% set commands = settings.getCommands() %}

    {% if commands %}
        <table class="data fullwidth craftai-commands__table">
            <thead>
                <tr>
                    <th>{{ "Name"|t('craft-ai') }}</th>
                    <th>{{ "Prompt"|t('craft-ai') }}</th>
                    <th class="thin">{{ "Enabled"|t('craft-ai') }}</th>
                    <th class="thin"></th>
                </tr>
            </thead>
            <tbody>
                {% for i, cmd in commands %}
                    {% include 'craft-ai/_command_row.twig' with {
                        index: i,
                        cmd: cmd,
                    } only %}
                {% endfor %}
            </tbody>
        </table>
    {% else %}
        <p class="light">{{ "No slash commands yet."|t('craft-ai') }}</p>
    {% endif %}

    <div class="craftai-commands__actions">
        <a class="btn add icon" href="{{ url('ai/commands/new') }}">
            {{ "Add a slash command"|t('craft-ai') }}
        </a>
    </div>
</div>
